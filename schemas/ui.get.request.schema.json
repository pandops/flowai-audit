{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/audit/ui.get.request.schema.json",
  "title": "audit.ui.get request",
  "description": "Request on audit.ui.get.pub (GET /ui/v1/teams/{team_id}/audit/{audit_id}). Headers as audit.ui.list. An audit_id that is not a positive int64 is answered 400 invalid_request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["params"],
  "properties": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id"],
      "properties": {
        "team_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "audit_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    }
  },
  "examples": [{ "params": { "team_id": 3, "audit_id": 5120 } }]
}
