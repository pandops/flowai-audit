{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowai.local/schemas/audit/error.reply.schema.json",
  "title": "audit error reply",
  "description": "Body of every audit error reply (NATS header status = 4xx/5xx). request_id is absent only when the request carried no valid request_id header.",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_request",
        "invalid_pagination",
        "resource_not_found",
        "service_unavailable"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    }
  },
  "examples": [
    {
      "code": "invalid_pagination",
      "message": "pagination is invalid",
      "request_id": 7001
    }
  ]
}
